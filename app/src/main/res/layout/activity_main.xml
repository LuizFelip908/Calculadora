<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Área do visor: cálculo em cima, resultado em destaque embaixo -->
    <LinearLayout
        android:id="@+id/displayArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/keyboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="start"
            android:textColor="@color/expression_text"
            android:textSize="26sp"
            tools:text="12 + 8 ×" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/result_highlight"
            android:textSize="64sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="64sp"
            tools:text="96" />
    </LinearLayout>

    <!-- Teclado -->
    <GridLayout
        android:id="@+id/keyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_keyboard"
        android:padding="12dp"
        android:columnCount="4"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Linha 1 -->
        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButton.Function"
            android:layout_height="76dp"
            android:text="@string/btn_clear" />

        <Button
            android:id="@+id/btnSign"
            style="@style/CalcButton.Function"
            android:layout_height="76dp"
            android:text="@string/btn_sign" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/CalcButton.Function"
            android:layout_height="76dp"
            android:text="@string/btn_percent" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalcButton.Operator"
            android:layout_height="76dp"
            android:text="@string/btn_divide" />

        <!-- Linha 2 -->
        <Button
            android:id="@+id/btn7"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_7" />

        <Button
            android:id="@+id/btn8"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_8" />

        <Button
            android:id="@+id/btn9"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_9" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalcButton.Operator"
            android:layout_height="76dp"
            android:text="@string/btn_multiply" />

        <!-- Linha 3 -->
        <Button
            android:id="@+id/btn4"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_4" />

        <Button
            android:id="@+id/btn5"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_5" />

        <Button
            android:id="@+id/btn6"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_6" />

        <Button
            android:id="@+id/btnSubtract"
            style="@style/CalcButton.Operator"
            android:layout_height="76dp"
            android:text="@string/btn_subtract" />

        <!-- Linha 4 -->
        <Button
            android:id="@+id/btn1"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_1" />

        <Button
            android:id="@+id/btn2"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_2" />

        <Button
            android:id="@+id/btn3"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_3" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButton.Operator"
            android:layout_height="76dp"
            android:text="@string/btn_add" />

        <!-- Linha 5 -->
        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_backspace" />

        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_0" />

        <Button
            android:id="@+id/btnDot"
            style="@style/CalcButton"
            android:layout_height="76dp"
            android:text="@string/btn_dot" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButton.Operator"
            android:layout_height="76dp"
            android:text="@string/btn_equals" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

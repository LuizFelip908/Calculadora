<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calculadora" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/keyboard_background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_button_number</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButton.Function">
        <item name="android:background">@drawable/bg_button_function</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:background">@drawable/bg_button_operator</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/text_operator</item>
    </style>
</resources>
